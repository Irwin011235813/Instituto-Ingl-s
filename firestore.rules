rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(uid)).data;
    }

    function rolActual() {
      return perfilDe(request.auth.uid).rol;
    }

    function estaActivo() {
      return perfilDe(request.auth.uid).activo == true;
    }

    function esAdmin() {  
      return estaAutenticado() && estaActivo() && rolActual() == 'admin';
    }

    function esProfesor() {
      return estaAutenticado() && estaActivo() && rolActual() == 'profesor';
    }

    function esAlumno() {
      return estaAutenticado() && estaActivo() && rolActual() == 'alumno';
    }

    function esGestion() {
      return esAdmin() || esProfesor();
    }

    // --- usuarios_autorizados ---
    // Cada usuario puede leer únicamente su propio perfil, para resolver su rol al iniciar sesión.
    // Solo un admin puede crear/editar perfiles (alta de nuevos usuarios, cambios de rol, baja lógica).
    match /usuarios_autorizados/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // --- cursos ---
    // Lectura pública para cualquier usuario autenticado y activo (alumnos necesitan verlos).
    // Escritura solo para admin/profesor.
    match /cursos/{cursoId} {
      allow read: if estaAutenticado() && estaActivo();
      allow create, update: if esGestion();
      allow delete: if esAdmin();
    }

    // --- turnos ---
    // Misma lógica que cursos: todos los usuarios activos pueden ver los turnos,
    // pero solo admin/profesor puede crearlos, editarlos o cancelarlos.
    // El campo "inscriptos" solo se modifica vía transacción junto con "inscripciones",
    // por eso no se restringe field-by-field aquí (ver nota abajo).
    match /turnos/{turnoId} {
      allow read: if estaAutenticado() && estaActivo();
      allow create, update, delete: if esGestion();
    }

    // --- inscripciones ---
    // Un alumno solo puede crear inscripciones a su propio nombre, y solo puede leer
    // o cancelar sus propias inscripciones. Admin/profesor pueden leer todas (para gestión y auditoría).
    match /inscripciones/{inscripcionId} {
      allow read: if esGestion() || (esAlumno() && resource.data.alumnoUid == request.auth.uid);

      allow create: if esAlumno()
                    && request.resource.data.alumnoUid == request.auth.uid
                    && request.resource.data.estado == 'activa';

      allow update: if esGestion()
                    || (esAlumno()
                        && resource.data.alumnoUid == request.auth.uid
                        && request.resource.data.alumnoUid == resource.data.alumnoUid);

      allow delete: if esAdmin();
    }

    // --- cuotas ---
    // Los documentos de cuotas los crea EXCLUSIVAMENTE la Cloud Function
    // (con Admin SDK, que no pasa por estas reglas) para que el monto no
    // pueda manipularse desde el navegador.
    match /cuotas/{cuotaId} {
      allow read: if esGestion() || (esAlumno() && resource.data.alumnoUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // --- inscripciones_pendientes ---
    // Alta de pre-inscripción desde la landing pública, SIN sesión iniciada.
    // Solo el equipo del instituto puede leer/gestionar estos registros.
    match /inscripciones_pendientes/{id} {
      allow create: if request.resource.data.nombre is string
                    && request.resource.data.email is string
                    && request.resource.data.telefono is string
                    && request.resource.data.estado == 'nueva';
      allow read, update, delete: if esGestion();
    }
  }
}

// NOTA IMPORTANTE:
// Firestore Security Rules no pueden validar de forma nativa que una escritura a
// "turnos.inscriptos" y una escritura a "inscripciones" ocurran juntas dentro de la
// misma transacción (eso ya lo garantiza el cliente con runTransaction en
// inscripcionesService.ts). Si se necesita blindar esto también a nivel de reglas,
// la alternativa robusta es mover la inscripción a una Cloud Function con
// Admin SDK, que sí puede validar invariantes multi-documento antes de escribir.
